# Guition ESP32-S3-4848S040: ESP32-S3 QFN56, 16 MB quad flash (3.3 V), 8 MB octal PSRAM, 480x480 ST7701S RGB panel.
# Flash: QIO/80M/16MB. If this board does not boot with QIO, switch to the documented fallback:
#   CONFIG_ESPTOOLPY_FLASHMODE_DIO=y (and drop the QIO line).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console on UART0 (GPIO43 TX / 44 RX) via the CH341 bridge. Native USB is unusable: GPIO19/20 are touch SDA / a data line.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Release the USB-Serial/JTAG pad so GPIO19/20 can be used as normal GPIO.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# RGB panel: reset the GDMA every VBlank so a late bounce-buffer/PSRAM fetch cannot leave a permanent shift.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
# CONFIG_LCD_RGB_ISR_IRAM_SAFE stays off for now (costs IRAM; revisit if the picture glitches during flash writes).

# Internal RAM budget (the Wi-Fi task aborted with ESP_ERR_NO_MEM in phy_track_pll_init when internal RAM ran out).
# Only allocations <= 512 bytes go to internal RAM first; the rest (LVGL, lwip, JSON, ...) goes to PSRAM. The 32 KB internal
# reserve stays for DMA/driver/Wi-Fi allocations that explicitly ask for internal memory.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Smaller Wi-Fi buffer pools. RX_BA_WIN (6, IDF default) must be <= dynamic RX (8) and <= 2 * static RX (4 -> 8): checked in
# wifi_init.c. Static RX buffers (about 1.6 KB each) are allocated from internal RAM at Wi-Fi init: 6 -> 4 saves ~3 KB for good.
# Dynamic RX/TX buffers are allocated per packet while traffic flows (about 1.6 KB each): the cap falls from 12 to 8 each, so the
# worst-case burst drops by ~6 KB per direction. The TCP window is only 5760 (4 x MSS), so 8 RX buffers are enough for one Domoticz poll.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6

# One software draw unit (the shared default is 2): lvgl creates one "swdraw" task per unit, each with an
# LV_DRAW_THREAD_STACK_SIZE (8192) internal-RAM stack, so this frees ~8 KB. LV_DRAW_THREAD_STACK_SIZE stays 8192 (no measurement of the
# draw thread's use yet). The board file is read after the shared firmware/sdkconfig.defaults, so this wins.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1

# Task stacks (internal RAM), see components/ru_core/Kconfig for the measured high-water marks. ru_console keeps 10240.
CONFIG_RU_TASK_STACK_WIFI=4608
CONFIG_RU_TASK_STACK_UI_BRIDGE=7168
CONFIG_RU_TASK_STACK_DZ_SERVICE=7168

# Diagnostics: periodic "heap" log line every 5 s and failed-allocation log (docs/development-setup.md).
CONFIG_RU_HEAP_LOG=y
